{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arjun2075/ucp/research/commercial-influence-provenance/schema/commercial_intervention_trace.schema.json",
  "title": "Experimental Commercial Influence Provenance Trace",
  "type": "object",
  "required": ["capability", "trace_id", "statement", "bindings"],
  "properties": {
    "capability": {
      "const": "io.github.arjun2075.shopping.commercial_influence"
    },
    "trace_id": {"type": "string", "minLength": 1},
    "statement": {"$ref": "#/$defs/statement"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "required": ["id", "actor", "asserter", "kind", "effect", "basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "actor": {"$ref": "#/$defs/party"},
        "asserter": {"$ref": "#/$defs/party"},
        "kind": {
          "enum": ["ranking", "recommendation", "cross_sell", "upsell", "bundle", "substitution", "other"]
        },
        "effect": {
          "enum": ["visibility", "ordering", "proposal", "commerce_state"]
        },
        "basis": {
          "enum": ["platform_merchandising", "seller_merchandising", "paid_placement", "referral_compensation", "owned_or_affiliated", "other_commercial", "unspecified"]
        },
        "sponsor": {"$ref": "#/$defs/party"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["stage", "subject_ref", "statement_digest", "binding_digest"],
      "properties": {
        "stage": {"enum": ["catalog", "offer", "cart", "checkout"]},
        "subject_ref": {"type": "string", "minLength": 1},
        "statement_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "predecessor_binding_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

